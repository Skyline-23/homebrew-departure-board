{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "departure-board-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "AIRPORT_CACHE", "class_name": "AirportCache" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AirportCache"] }],
  "vars": {
    "CACHE_SECONDS": "900",
    "DAILY_REQUEST_LIMIT": "4"
  }
}
