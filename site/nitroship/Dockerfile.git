FROM node:22-bookworm-slim AS website
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /source/site
COPY site/package.json site/package-lock.json ./
RUN npm ci --no-audit --no-fund
WORKDIR /source
COPY Casks/departure-board.rb ./Casks/departure-board.rb
COPY docs/install-guide.md docs/install-guide.ko.md ./docs/
COPY Resources/Guide ./Resources/Guide
COPY script/build-guide.py script/build-site.py ./script/
COPY site ./site
ENV NEXT_TELEMETRY_DISABLED=1
RUN python3 script/build-site.py

FROM node:22-slim
WORKDIR /app
COPY --from=website --chown=node:node /source/work/site ./public
COPY --chown=node:node site/nitroship/server.mjs site/download-handler.mjs ./
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
